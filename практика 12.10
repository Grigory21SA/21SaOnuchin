задача 1 состояние здоровья
t = float(input("Введите температуру: "))
p = float(input("Введите давление (верхнее): "))
pl = float(input("Введите пульс (уд/мин): "))

m = 0
s = 0

if t < 35 or t > 38:
    s += 1
elif t < 36 or t > 37:
    m += 1

if p < 105 or p > 140:
    s += 1
elif p < 110 or p > 130:
    m += 1

if pl < 55 or pl > 110:
    s += 1
elif pl < 60 or pl > 100:
    m += 1

if s >= 1:
    print("Требуется врач")
elif m >= 1:
    print("Легкое недомогание")
else:
    print("Нормальное состояние")
