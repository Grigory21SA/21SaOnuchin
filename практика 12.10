задача 1 состояние здоровья
t = float(input("Введите температуру: "))
p = float(input("Введите давление (верхнее): "))
pl = float(input("Введите пульс (уд/мин): "))

m = 0
s = 0

if t < 35 or t > 38:
    s += 1
elif t < 36 or t > 37:
    m += 1

if p < 105 or p > 140:
    s += 1
elif p < 110 or p > 130:
    m += 1

if pl < 55 or pl > 110:
    s += 1
elif pl < 60 or pl > 100:
    m += 1

if s >= 1:
    print("Требуется врач")

задача 2 рулетка
n = int(input())

if n < 0 or n > 36:
    print("ошибка ввода")
elif n == 0:
    print("зеленый")
elif 1 <= n <= 10:
    if n % 2 != 0:
        print("красный")
    else:
        print("черный")
elif 11 <= n <= 18:
    if n % 2 != 0:
        print("черный")
    else:
        print("красный")
elif 19 <= n <= 28:
    if n % 2 != 0:
        print("красный")
    else:
        print("черный")
elif 29 <= n <= 36:
    if n % 2 != 0:
        print("черный")
    else:
        print("красный")

задача 3 шахматная доска
c1 = int(input())
r1 = int(input())
c2 = int(input())
r2 = int(input())

s1 = (c1 + r1) % 2
s2 = (c2 + r2) % 2

if s1 == s2:
    print("YES")
else:
    print("NO")

задача 4 ход сллона
c1 = int(input())
r1 = int(input())
c2 = int(input())
r2 = int(input())

if abs(c1 - c2) == abs(r1 - r2):
    print("YES")
else:
    print("NO")

